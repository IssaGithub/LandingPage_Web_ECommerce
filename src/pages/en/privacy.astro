---
import { translations } from '../../i18n/translations.js';
import '../../styles/global.css';

const t = translations.en;
const baseUrl = import.meta.env.BASE_URL || '/';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Privacy Policy - {t.company}</title>
    <meta name="description" content="Privacy policy of Issa Zaytoun - Web & E-Commerce Solutions" />
    
    <link rel="alternate" hreflang="en" href={baseUrl + 'en/privacy'} />
    <link rel="alternate" hreflang="de" href={baseUrl + 'de/datenschutz'} />
  </head>
  <body class="bg-gray-900 text-white min-h-screen">
    <!-- Navigation -->
    <nav class="bg-gray-800 py-4">
      <div class="max-w-6xl mx-auto px-8 flex justify-between items-center">
        <a href={baseUrl} class="text-xl font-bold text-cyan-400">
          {t.company}
        </a>
        <div class="flex space-x-4">
          <a href={baseUrl} class="text-gray-300 hover:text-white transition-colors">Home</a>
          <a href={baseUrl + 'de/datenschutz'} class="text-gray-300 hover:text-white transition-colors">Deutsch</a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-8 py-12">
      <h1 class="text-4xl font-bold mb-8 text-cyan-400">Privacy Policy</h1>
      
      <div class="prose prose-invert max-w-none">
        <section class="mb-8">
          <h2 class="text-2xl font-semibold mb-4 text-white">1. Privacy at a Glance</h2>
          
          <h3 class="text-xl font-semibold mb-3 text-cyan-400">General Information</h3>
          <p class="mb-4 text-gray-300">
            The protection of your personal data is important to us. This privacy policy informs you about how we handle your data when you visit this website.
          </p>

          <h3 class="text-xl font-semibold mb-3 text-cyan-400">Data Collection on this Website</h3>
          <p class="mb-4 text-gray-300">
            <strong>Important Notice:</strong> This website does not collect any personal data from visitors. We do not use contact forms, newsletter subscriptions, or other data collection methods.
          </p>
          <p class="mb-6 text-gray-300">
            The only way to contact us is through external services like Calendly (for appointment booking) or directly via email/phone. This contact takes place outside of this website.
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-semibold mb-4 text-white">2. Data Controller</h2>
          <div class="bg-gray-800 p-6 rounded-lg">
            <p class="mb-2 text-gray-300">Responsible for this website is:</p>
            <p class="mb-2"><strong>Issa Zaytoun</strong></p>
            <p class="mb-2">Web & E-Commerce Solutions</p>
            <p class="mb-2">Email: issa.zaytoun@gmail.com</p>
            <p class="mb-2">Phone: +49 176 81441063</p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-semibold mb-4 text-white">3. Hosting</h2>
          <div class="bg-gray-800 p-6 rounded-lg">
            <p class="mb-4 text-gray-300">
              This website is hosted by:
            </p>
            <p class="mb-2 text-gray-300"><strong>Vercel Inc.</strong></p>
            <p class="mb-2 text-gray-300">340 S Lemon Ave #4133</p>
            <p class="mb-2 text-gray-300">Walnut, CA 91789</p>
            <p class="mb-4 text-gray-300">USA</p>
            <p class="text-gray-300">
              For more information about data processing by Vercel, please refer to their privacy policy: 
              <a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:text-cyan-300">
                https://vercel.com/legal/privacy-policy
              </a>
            </p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-semibold mb-4 text-white">4. Server Log Files</h2>
          <div class="bg-gray-800 p-6 rounded-lg">
            <p class="mb-4 text-gray-300">
              When visiting this website, the following information is automatically stored in server log files:
            </p>
            <ul class="list-disc list-inside mb-4 text-gray-300 space-y-1">
              <li>IP address</li>
              <li>Browser type and version</li>
              <li>Operating system</li>
              <li>Referrer URL</li>
              <li>Time of access</li>
              <li>Requested pages</li>
            </ul>
            <p class="text-gray-300">
              This data is used exclusively for the technical provision and security of the website. No combination with other data sources takes place. The legal basis is Art. 6 para. 1 lit. f GDPR (legitimate interest in the technical provision of the website).
            </p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-semibold mb-4 text-white">5. External Services</h2>
          
          <h3 class="text-xl font-semibold mb-3 text-cyan-400">Calendly</h3>
          <div class="bg-gray-800 p-6 rounded-lg mb-6">
            <p class="mb-4 text-gray-300">
              For appointment booking, we use the external service Calendly. Provider is Calendly LLC, 271 17th St NW, 10th Floor, Atlanta, GA 30363, USA.
            </p>
            <p class="mb-4 text-gray-300">
              <strong>Important Notice:</strong> When you click the "Free Consultation" button, Calendly opens in a new browser window. Only then is data transmitted to Calendly. This website itself does not collect any data.
            </p>
            <p class="text-gray-300">
              For more information about data processing by Calendly: 
              <a href="https://calendly.com/privacy" target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:text-cyan-300">
                https://calendly.com/privacy
              </a>
            </p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-semibold mb-4 text-white">6. SSL Encryption</h2>
          <div class="bg-gray-800 p-6 rounded-lg">
            <p class="text-gray-300">
              This website uses SSL encryption for secure data transmission. You can recognize an encrypted connection by the fact that the address line starts with "https://" and a lock symbol is displayed in the browser line.
            </p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-semibold mb-4 text-white">7. Your Rights</h2>
          <div class="bg-gray-800 p-6 rounded-lg">
            <p class="mb-4 text-gray-300">
              Since we do not collect any personal data, most GDPR rights are not applicable in this case. If you still have questions or want to contact us:
            </p>
            <p class="mt-4 text-gray-300">
              Email: 
              <a href="mailto:issa.zaytoun@gmail.com" class="text-cyan-400 hover:text-cyan-300">issa.zaytoun@gmail.com</a>
            </p>
            <p class="text-gray-300">
              Phone: +49 176 81441063
            </p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-2xl font-semibold mb-4 text-white">8. Changes to this Privacy Policy</h2>
          <div class="bg-gray-800 p-6 rounded-lg">
            <p class="text-gray-300">
              We reserve the right to update this privacy policy as needed. You can always find the current version on this page.
            </p>
          </div>
        </section>
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 py-8 mt-16">
      <div class="max-w-6xl mx-auto px-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
          <div class="text-gray-400 text-sm mb-4 md:mb-0">
            &copy; {new Date().getFullYear()} {t.footer}
          </div>
          <div class="flex space-x-6 text-sm">
            <a href={baseUrl + 'en/impressum'} class="text-gray-400 hover:text-white transition-colors">Legal Notice</a>
            <a href={baseUrl + 'en/privacy'} class="text-cyan-400 hover:text-white transition-colors">Privacy Policy</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>